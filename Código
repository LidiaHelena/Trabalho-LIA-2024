#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <DHT.h>

// Inicializa o LCD com o endereço 0x27, 16 colunas e 2 linhas
LiquidCrystal_I2C LCD(0x27, 16, 2);

// Pino digital do sensor DHT11
#define DHTPIN 2     // Pino de dados do DHT11 (pode ser ajustado conforme necessário)

// Tipo de sensor DHT11
#define DHTTYPE DHT11

// Inicializa o sensor DHT11
DHT dht(DHTPIN, DHTTYPE);

// Pinos para alertas de temperatura baixa e alta
int AlertaTempBaixa = 8;
int AlertaTempAlta = 13;

// Limites de temperatura (Celsius)
int TempBaixa = 29;
int TempAlta = 29.2;

void setup() {
  // Configura os pinos de alerta como saída
  pinMode(AlertaTempBaixa, OUTPUT);
  pinMode(AlertaTempAlta, OUTPUT);

  // Inicializa o LCD
  LCD.begin(16, 2);
  LCD.backlight();  // Liga o backlight do LCD

  // Exibe a mensagem inicial no LCD
  LCD.setCursor(0, 0);
  LCD.print("Temperatura:");
  LCD.setCursor(0, 1);
  LCD.print("C   ");

  // Inicializa o sensor DHT11
  dht.begin();

  // Inicializa a comunicação serial
  Serial.begin(9600);
}

void loop() {
  // Lê a temperatura e umidade do sensor DHT11
  float TemperaturaC = dht.readTemperature();  // Temperatura em Celsius
  float TemperaturaF = dht.readTemperature(true);  // Temperatura em Fahrenheit (true -> Fahrenheit)

  // Verifica se a leitura falhou
  if (isnan(TemperaturaC) || isnan(TemperaturaF)) {
    Serial.println("Falha na leitura do sensor DHT11!");
    return;
  }

  // Atualiza o LCD com as novas temperaturas
  LCD.setCursor(0, 1);
  LCD.print("    ");  // Limpa os valores anteriores
  LCD.print(TemperaturaC, 1);  // Exibe a temperatura em Celsius

  //LCD.setCursor(9, 1);
  //LCD.print("    ");  // Limpa os valores anteriores
  //LCD.print(TemperaturaF, 1);  // Exibe a temperatura em Fahrenheit

  // Envia os dados para o Monitor Serial
  Serial.print("Temperatura em Celsius: ");
  Serial.print(TemperaturaC, 1);
  Serial.print(" °C, ");
  Serial.print("Temperatura em Fahrenheit: ");
  Serial.print(TemperaturaF, 1);
  Serial.println(" °F");

  // Verifica se a temperatura está fora dos limites
  if (TemperaturaC >= TempAlta) {
    digitalWrite(AlertaTempBaixa, LOW);  // Desliga o alerta de baixa
    digitalWrite(AlertaTempAlta, HIGH);  // Liga o alerta de alta
    Serial.println("ALERTA: Temperatura alta!");
  } else if (TemperaturaC <= TempBaixa) {
    digitalWrite(AlertaTempBaixa, HIGH);  // Liga o alerta de baixa
    digitalWrite(AlertaTempAlta, LOW);   // Desliga o alerta de alta
    Serial.println("ALERTA: Temperatura baixa!");
  } else {
    digitalWrite(AlertaTempBaixa, LOW);  // Desliga os alertas
    digitalWrite(AlertaTempAlta, LOW);
    Serial.println("Temperatura dentro do intervalo seguro.");
  }

  // Aguarda 2 segundos para a próxima leitura
  delay(2000);
}
